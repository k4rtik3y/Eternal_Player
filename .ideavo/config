{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Web Dependencies",
      "command": "npm --prefix web install"
    }
  ],
  "codeChecks": [],
  "buildSteps": [
    {
      "name": "Build Web App",
      "command": "npm --prefix web run build"
    }
  ],
  "runStep": [
    {
      "name": "Run Web App",
      "command": "npm --prefix web run dev -- --host 0.0.0.0 --port 3000",
      "port": "3000"
    }
  ],
  "deploySteps": [],
  "cleanupFiles": [
    "web/dist/",
    "web/node_modules/"
  ],
  "packageManager": "npm",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    },
    {
      "name": "web",
      "path": "web/.env"
    }
  ]
}
